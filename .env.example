# ============================================================
# Plantilla de variables de entorno — Proyecto Orquestador (1A)
# Copiar a backend/.env en desarrollo local.
# NUNCA escribir secretos reales en este archivo.
# ============================================================

# Servidor Backend
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# Base de Datos PostgreSQL en Neon (Prisma requiere ambas URLs)
# DATABASE_URL: conexion agrupada (pooled) para consultas en ejecucion
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: conexion directa obligatoria para migraciones SQL de Prisma
DIRECT_URL="postgresql://USER:PASSWORD@HOST.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Sesiones seguras (orq_session) — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="reemplazar-por-64-caracteres-hexadecimales-aleatorios"

# Cifrado AES-256-GCM de secretos (versionado de llave maestra)
# Generar cada llave de 32 bytes con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CURRENT_ENCRYPTION_KEY_VERSION=1
ENCRYPTION_MASTER_KEY_V1="reemplazar-por-64-caracteres-hexadecimales-32-bytes"

# GitHub OAuth App (scopes: read:user, repo)
GITHUB_CLIENT_ID="tu-github-oauth-client-id"
GITHUB_CLIENT_SECRET="tu-github-oauth-client-secret"
GITHUB_OAUTH_CALLBACK_URL="http://localhost:5173/api/v1/auth/github/callback"
